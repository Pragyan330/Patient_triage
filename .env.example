# copy to .env (gitignored). Everything runs on localhost - no hosting needed.

# Mistral key, shared by the intake server and the grounding module
mistral_api=<your-mistral-api-key>
MISTRAL_API_KEY=<same-key-nodes-sdk-reads-this-name>

# Where OP's intake server forwards its generated schema.
# scripts/run_all.py sets this automatically; only needed if you run app.js alone.
PRAGYAN_SERVER_URL=http://127.0.0.1:8000/api/grounded

# Ports, only if a default is already taken on your machine
# INTAKE_PORT=8080
# GROUNDING_PORT=8000
# QUEUE_UI_PORT=5173
